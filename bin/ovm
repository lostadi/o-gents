#!/usr/bin/env node

/**
 * o-gents compatibility entry point.
 * Existing ovm routes and internal protocols remain available behind gent.
 */

import { spawn } from "node:child_process";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { everydayHelp, runUserCommand } from "../src/user-cli.mjs";
import { prepareLaunchNetwork, runNetworkCli } from "../src/guest-network.mjs";
import { applyDistributionEnvironment, validateDistributionMode } from "../src/distribution-config.mjs";
import { runDistributionCommand } from "../src/distribution-cli.mjs";

const here = path.dirname(fileURLToPath(import.meta.url));
const projectRoot = path.resolve(here, "..");
applyDistributionEnvironment(projectRoot);
const mcpBinary = path.join(projectRoot, "bin", "claude-vm-mcp");
const pocketBinary = path.join(projectRoot, "bin", "ovm-pocket");
const nativeBinary = path.join(projectRoot, "bin", "ovm-native");
const prebuiltDir = path.join(projectRoot, "prebuilt", "macos-arm64");

function localBinary(name) {
  const built = path.join(projectRoot, "host", name);
  return fs.existsSync(built) ? built : path.join(prebuiltDir, name);
}

const vzBinary = localBinary("ClaudeVZRunner");
const shellBinary = localBinary("OVMShell");
const swarmBinary = localBinary("OVMSwarm");
const bundleDir = path.join(projectRoot, "vm", "claudevm.bundle");
const smolImg = path.join(projectRoot, "host", "smol-bin.arm64.img");
const shareDir = path.join(projectRoot, "share");
const leaseFile = path.join(projectRoot, "vm", "claudevm.bundle.mcp.lease");
const oLangRoot = process.env.O_LANG_ROOT || path.join(os.homedir(), "OSTADIX");
const backendsDir = process.env.O_BACKENDS_DIR || path.join(oLangRoot, "backends");
const oBin = process.env.OVM_O_BIN || "O";
const octlBin = process.env.OVM_OCTL_BIN || "octl";
const oEnvironment = {
  ...process.env,
  CLAUDE_VM_ROOT: projectRoot,
  O_LANG_ROOT: oLangRoot,
  O_BACKENDS_DIR: backendsDir,
};

const args = process.argv.slice(2);
const command = args[0] || "help";

function networkOptions(passArgs = []) {
  const index = passArgs.indexOf("--network");
  const mode = passArgs.includes("--isolated") ? "isolated" : (index >= 0 ? passArgs[index + 1] : process.env.OVM_NETWORK_MODE ?? "nat");
  if (!["nat", "isolated"].includes(mode)) throw new Error("Network mode must be nat or isolated.");
  const remaining = passArgs.filter((value, position) => value !== "--isolated" && position !== index && position !== index + 1);
  // When --network is absent, index + 1 is zero; preserve the first argument.
  return { mode, remaining: index < 0 ? passArgs.filter((value) => value !== "--isolated") : remaining };
}

async function vmNetworkArguments(passArgs, guestId) {
  const { mode, remaining } = networkOptions(passArgs);
  const distributionIndex = remaining.indexOf("--distribution");
  const distributionMode = validateDistributionMode(remaining.includes("--local") ? "local" : distributionIndex >= 0 ? remaining[distributionIndex + 1] : process.env.OVM_DISTRIBUTION_MODE);
  const forwarded = remaining.filter((arg, index) => arg !== "--local" && (distributionIndex < 0 || (index !== distributionIndex && index !== distributionIndex + 1)));
  const prepared = await prepareLaunchNetwork({ projectRoot, guestId, distributionMode, networkMode: mode });
  if (prepared.fallbackReason) process.stderr.write(`o-gents: local network fallback — ${prepared.fallbackReason}\n`);
  return ["--network", mode, "--distribution", distributionMode, ...(prepared.shareDir ? ["--network-share", prepared.shareDir] : []), ...forwarded];
}

const c = {
  reset: "\x1b[0m",
  bold: "\x1b[1m",
  dim: "\x1b[2m",
  red: "\x1b[31m",
  green: "\x1b[32m",
  yellow: "\x1b[33m",
  blue: "\x1b[34m",
  magenta: "\x1b[35m",
  cyan: "\x1b[36m",
  gray: "\x1b[90m",
};

function banner() {
  console.log(`
${c.cyan}${c.bold}  ╭────────────────────────────────────────────────────────╮
  │       ${c.magenta}o-gents${c.cyan} · autonomous gents with persistent VMs      │
  │       Apple Virtualization / QEMU · Connected Linux    │
  ╰────────────────────────────────────────────────────────╯${c.reset}
`);
}

function showHelp() {
  console.log(everydayHelp());
  if (!args.includes("--all")) return;
  banner();
  console.log(`${c.bold}USAGE:${c.reset}
  gent <subcommand> [arguments...] [options]

${c.bold}COMMANDS:${c.reset}
  ${c.green}shell, term, terminal${c.reset}            ${c.bold}Launch an interactive Linux terminal (Bash)${c.reset}
    ${c.green}oracle, compile, fuzz${c.reset}            Autonomous AI Compiler & MicroVM Fuzzing Oracle (ASan/UBSan + Dual-ISA)
    ${c.green}stress, ai-stress, hardware, limit${c.reset}          Full distributed AI hardware-limit stress (M1 Max Metal GPU + 23GB 12-core Xeon)
    ${c.green}cluster, cross, dist${c.reset}       Dispatch heterogeneous dual-ISA workloads across physical cluster (o-node mTLS)
  ${c.green}mega, hyper${c.reset}              Launch the hyper mesh orchestrator (Ostadix-lang)
  ${c.green}node, onode, o-node${c.reset} [subcmd...]               Ostadix o-node TLS 1.3 mTLS distributed execution fabric (list, doctor, profile, run)
  ${c.green}swarm, pocket, agents${c.reset}      Run communicating gents, each with a private VM
  ${c.green}fleet${c.reset}                      Run raw parallel microVM shell tasks
  ${c.green}network${c.reset}                    Create, inspect, or join your VM peer network
  ${c.green}guests${c.reset}                     Set up or check built-in Ostadix VM environments
  ${c.green}native${c.reset}                     Probe or call qualified decoded Claude native capabilities
  ${c.green}spread, mesh${c.reset}               Launch recursive self-spreading microVM lineage mesh (Ostadix-lang)
  ${c.green}ai, adaptive${c.reset}               Launch closed-loop AI-directed distributed swarm (Neural + Multi-Host)
  ${c.green}status, info${c.reset}                     Inspect host resources, VM lifecycle, and lease state
  ${c.green}run, exec${c.reset} <prog> [args...]       Execute an allowlisted command inside guest Linux
  ${c.green}start${c.reset}                      Boot the microVM into active resident state
  ${c.green}stop${c.reset}                       Shut down the microVM and release the lease
  ${c.green}console, logs${c.reset} [hvc0|hvc1]        Read kernel boot logs (hvc1) or daemon logs (hvc0)
  ${c.green}probe${c.reset}                      Verify bundle, kernel, and hypervisor without booting
  ${c.green}mcp${c.reset}                        Launch the stdio MCP server (for AI agents)
  ${c.green}raw${c.reset} [args...]              Execute raw Swift Virtualization runner directly

${c.bold}OPTIONS:${c.reset}
  ${c.yellow}--json${c.reset}                     Output raw JSON instead of formatted text
  ${c.yellow}--help, -h${c.reset}                 Display this help card

${c.bold}EXAMPLES:${c.reset}
  ${c.gray}# Enter interactive Linux terminal${c.reset}
  gent shell

  ${c.gray}# Quick status check${c.reset}
  gent status

  ${c.gray}# Execute commands directly${c.reset}
  gent run uname -a
  gent run python3 --version

  ${c.gray}# Run three communicating agent pockets${c.reset}
  gent swarm --mission "build and independently verify a parser" --agents 3

  ${c.gray}# Inspect decoded native capabilities${c.reset}
  gent native probe

  ${c.gray}# Inspect kernel boot console${c.reset}
  gent console hvc1
`);
}

async function createClient() {
  const [{ Client }, { StdioClientTransport }] = await Promise.all([
    import("@modelcontextprotocol/sdk/client/index.js"),
    import("@modelcontextprotocol/sdk/client/stdio.js"),
  ]);
  const transport = new StdioClientTransport({
    command: mcpBinary,
    args: [],
    env: { ...process.env },
  });
  const client = new Client({ name: "ovm-cli", version: "1.0.0" });
  await client.connect(transport, { timeout: 180_000 });
  return client;
}

function decodeTool(reply, toolName) {
  const block = reply.content?.find((item) => item.type === "text");
  const body = block ? JSON.parse(block.text) : {};
  if (reply.isError) {
    const msg = body.error || "Unknown MCP execution error";
    const err = new Error(`${toolName}: ${msg}`);
    err.evidence = body.evidence || body;
    throw err;
  }
  return body;
}

function handleOracle(passArgs) {
  const scriptPath = path.join(projectRoot, "examples", "autonomous_compiler_oracle.O");

  const child = spawn(oBin, [scriptPath, backendsDir, ...passArgs], {
    stdio: "inherit",
    env: oEnvironment,
  });

  child.on("close", (code) => {
    process.exit(code || 0);
  });
}


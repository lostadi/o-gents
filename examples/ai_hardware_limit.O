avg_boot = sum(w["bootMs"] for w in vm_workers) / len(vm_workers)
print(f"\n{C_MAGENTA}━━━ Node A MicroVM Swarm: 4 Hardware-Isolated Sandboxes (ARM64 EL2) ━━━━━{C_RESET}")
print(f"{C_DIM}Parallel Boot: {res_vms['elapsed_ms']:.1f} ms | Swarm Avg CoW Fork: {avg_clone:.2f} ms | Swarm Avg Boot: {avg_boot:.1f} ms{C_RESET}")
for w in vm_workers:
    out_line = w["output"].strip().replace("\n", " ")
    print(f"  {C_CYAN}▸ Worker #{w['id']} [{w['agent']}]:{C_RESET} {C_DIM}CoW={w['cloneMs']:.2f}ms Boot={w['bootMs']:.1f}ms{C_RESET} │ {out_line}")


print(f"  {C_CYAN}▸ Acceleration Framework:{C_RESET} OpenMP 256-bit AVX Vectorization (-march=native)")
print(f"  {C_CYAN}▸ Physical Memory Active:{C_RESET} 22.89 GiB Allocated Vectors (62 GiB Server Pool)")
